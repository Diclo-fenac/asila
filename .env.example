DATABASE_URL=postgresql+asyncpg://asila_app:replace-with-ASILA_DB_APP_PASSWORD@localhost:5432/asila_platform

ASILA_SETUP_TOKEN=generate-a-random-one-time-bootstrap-token
ASILA_MASTER_KEY=generate-a-random-encryption-key
ASILA_MULTI_TENANCY_ENABLED=false
POSTGRES_PASSWORD=generate-a-random-postgres-admin-password
ASILA_DB_APP_PASSWORD=generate-a-random-runtime-database-password
ASILA_DB_MIGRATOR_PASSWORD=generate-a-random-migrator-database-password
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OIDC_ISSUER=
OIDC_AUDIENCE=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=asila_app

# Private document processing: provision signatures separately, then enable the
# document-processing Compose profile. Parser/scanner containers have no network.
ASILA_CLAMAV_DATABASE_DIR=/absolute/path/to/verified-clamav-signatures
ASILA_SCANNER_SOCKET=/run/asila-scanner/clamd.sock
ASILA_PARSER_SOCKET=/run/asila-parser/parser.sock
# Reject scanner databases older than seven days (maximum permitted override: 30).
ASILA_SCANNER_MAX_AGE_DAYS=7
