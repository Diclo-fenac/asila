# ============================================
# ASILA ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values.
# NEVER commit .env — only this .env.example file.
# ============================================

# --- Application ---
# Required: Application environment context (development | staging | production)
ENVIRONMENT=development
# Required: Encryption key for provider credentials. Generate with: openssl rand -hex 32
ASILA_MASTER_KEY=
# Required (Dev): One-time local bootstrap token. Generate with: openssl rand -hex 32
ASILA_SETUP_TOKEN=
# Optional (Prod): Enable multiple organizations in one deployment
ASILA_MULTI_TENANCY_ENABLED=false
# Optional (Prod): Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173

# --- Security & Auth ---
# Optional: Generic OIDC issuer URL
OIDC_ISSUER=
# Optional: OIDC API audience
OIDC_AUDIENCE=
# Optional: Explicit JWKS endpoint
OIDC_JWKS_URL=

# --- AI Backend (Embeddings & Generation) ---
# Required: Provider selection (ollama | openai-compatible | gemini)
AI_PROVIDER=ollama

# Required if AI_PROVIDER=ollama: Local Ollama endpoint
OLLAMA_BASE_URL=http://ollama:11434
# Required if AI_PROVIDER=ollama: Default generation model
OLLAMA_GENERATION_MODEL=llama3.2
# Required if AI_PROVIDER=ollama: Default embedding model
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Required if AI_PROVIDER=openai-compatible: OpenAI API key
# OPENAI_API_KEY=
# Optional if AI_PROVIDER=openai-compatible: Override base URL
# OPENAI_BASE_URL=
# Required if AI_PROVIDER=openai-compatible: Generation model
# OPENAI_GENERATION_MODEL=gpt-4o-mini
# Required if AI_PROVIDER=openai-compatible: Embedding model
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database (PostgreSQL) ---
# Required: The non-superuser asila_app role for API and worker processes.
POSTGRES_USER=asila_app
# Required: Database password for asila_app. Never reuse across environments.
POSTGRES_PASSWORD=
# Required: Database name
POSTGRES_DB=asila_platform
# Required: PostgreSQL host address
POSTGRES_HOST=postgres
# Required: PostgreSQL port
POSTGRES_PORT=5432
# Required: SQLAlchemy async connection URL
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}


# --- Document Parsing (Docling) ---
# Required: URL to the Docling Serve microservice
DOCLING_URL=http://docling:5001
# Optional: Docling request timeout in seconds
DOCLING_TIMEOUT=300
# Optional: Maximum allowed file size for parsing in MB
ASILA_MAX_FILE_SIZE_MB=50

# --- Google Gemini (Optional) ---
# Required if AI_PROVIDER=gemini: API Key from https://aistudio.google.com/apikey
# GOOGLE_API_KEY=
# Required if AI_PROVIDER=gemini: Generation model
# GEMINI_MODEL=gemini-2.5-flash-lite
# Required if AI_PROVIDER=gemini: Embedding model
# EMBEDDING_MODEL=models/gemini-embedding-001

# --- HashiCorp Vault (Optional) ---
# Optional (Prod): Vault API URL
# VAULT_URL=http://localhost:8200
# Optional (Prod): Vault authentication token
# VAULT_TOKEN=
